---
import Base from '../layouts/Base.astro';
import { cargarEventos, fmt, TIPOS, SECCIONES } from '../lib/db.js';
const { eventos, tiposActivos } = await cargarEventos();
const hayClasif = eventos.some((e) => e.clasificado);
const secciones = Object.entries(SECCIONES)
  .map(([clave, nombre]) => ({ clave, nombre, eventos: eventos.filter((e) => e.seccion === clave) }))
  .filter((s) => s.eventos.length > 0);
---
<Base>
  <p class="aviso">
    Economía de Paraguay, con prioridad al mercado de valores. Se listan hechos cubiertos por al menos dos medios (en Mercado de valores basta uno).
    {hayClasif
      ? ' El registro muestra qué tipo de medio los cubrió y cuál no.'
      : ' La clasificación de medios está en revisión: por ahora solo hay titulares y enlaces.'}
  </p>
  <nav class="indice" aria-label="Secciones">
    {secciones.map((s) => <a href={`#${s.clave}`}>{s.nombre} <span>{s.eventos.length}</span></a>)}
  </nav>
  {secciones.map((s) => (
    <section id={s.clave}>
      <h2 class="seccion">{s.nombre}</h2>
      <ol class="lista">
        {s.eventos.map((e, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3><a href={`${import.meta.env.BASE_URL}/evento/${e.id}/`}>{e.title}</a></h3>
              <p class="etq">{e.medios} medios · {e.notas.length} notas · {fmt(e.fecha)}</p>
              {e.clasificado && (
                <p class="registro" aria-label="Cobertura por tipo de medio">
                  {tiposActivos.map((t) => (
                    <span class={e.cubiertos.includes(t) ? 'cub' : 'ciego'}>
                      {e.cubiertos.includes(t) ? '■' : '□'} {TIPOS[t]}{e.cubiertos.includes(t) ? '' : ' (no lo cubrió)'}
                    </span>
                  ))}
                </p>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
  {eventos.length === 0 && <p>Todavía no hay hechos cubiertos por más de un medio.</p>}
</Base>
<style>
  .aviso { font-size: .9rem; }
  .indice { display: flex; flex-wrap: wrap; gap: .5rem 1.4rem; margin: 1rem 0 .5rem; font: .8rem var(--mono); }
  .indice a { text-decoration: none; }
  .indice a:hover { text-decoration: underline; text-decoration-color: var(--acento); }
  .indice span { color: var(--acento); }
  .seccion { margin: 2rem 0 .2rem; padding-bottom: .4rem; border-bottom: 2px solid var(--tinta); font-size: .85rem; letter-spacing: .08em; text-transform: uppercase; font-family: var(--mono); }
  .lista { list-style: none; margin: 0; padding: 0; columns: 2 24rem; column-gap: 2.5rem; column-rule: 1px solid var(--regla); }
  .lista li { break-inside: avoid; display: grid; grid-template-columns: 2.4rem 1fr; padding: 1rem 0; border-bottom: 1px solid var(--regla); }
  .num { font: .8rem var(--mono); color: var(--acento); padding-top: .55rem; }
  h3 { margin: 0 0 .3rem; font-size: 1.3rem; line-height: 1.2; font-weight: 700; }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-color: var(--acento); }
  .etq { margin: 0; }
  .registro { margin: .5rem 0 0; display: flex; flex-wrap: wrap; gap: .15rem .9rem; font: .75rem var(--mono); }
  .cub { color: var(--tinta); }
  .ciego { color: var(--acento); }
</style>
