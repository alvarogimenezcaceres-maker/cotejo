---
import Base from '../layouts/Base.astro';
import Carriles from '../components/Carriles.astro';
import { cargarEventos, fmt, fmtCorto, TIPOS, SECCIONES } from '../lib/db.js';
const { portada, comunicados, tiposActivos } = await cargarEventos();
const hayClasif = portada.some((e) => e.clasificado);
const hero = portada[0];
const resto = portada.slice(1);
const secciones = Object.entries(SECCIONES)
  .map(([clave, nombre]) => ({ clave, nombre, eventos: resto.filter((e) => e.seccion === clave) }))
  .filter((s) => s.eventos.length > 0);
const base = import.meta.env.BASE_URL;
const recientes = comunicados.slice(0, 10);
const anteriores = comunicados.slice(10);
const iso = (d) => new Date(d).toISOString();
const quienes = (e) => {
  const n = e.cobertura.medios.map((m) => m.nombre);
  return n.length > 3 ? `${n.slice(0, 3).join(', ')} +${n.length - 3}` : n.join(', ');
};
const partir = (t) => {
  const i = t.indexOf(': ');
  return i < 0 ? ['', t] : [t.slice(0, i), t.slice(i + 2)];
};
const descripcion = hero ? `${hero.title}. Cómo lo cubrió cada medio y quién publicó primero.` : undefined;
---
<Base description={descripcion}>
  <section class="intro">
    <p class="kicker">Economía y mercado de valores · Paraguay</p>
    <h1>Un mismo hecho, contado por cada medio.</h1>
    <p class="lede">
      Reunimos las notas de varios medios sobre lo mismo: quién lo contó primero, quién se sumó y cuándo.
      <span class="upd">Actualizado <time datetime={iso(new Date())} data-rel>{fmt(new Date())}</time></span>
    </p>
  </section>

  <div class="pagina">
    <div class="principal">
      {hero && (
        <section class="hero card" aria-labelledby="hero-t">
          <p class="hero-top">
            <span class="chip">Hecho destacado</span>
            <span class="como" title="Se ordena por cobertura (medios distintos), volumen de notas y frescura. Es un orden provisional: no mide impacto de mercado.">Cómo se ordena ⓘ</span>
          </p>
          <h2 id="hero-t"><a href={`${base}/evento/${hero.id}/`}>{hero.title}</a></h2>
          <p class="meta">
            {hero.medios} {hero.medios === 1 ? 'medio' : 'medios'} · {hero.notas.length} notas · última nota{' '}
            <time datetime={iso(hero.fecha)} data-rel>{fmt(hero.fecha)}</time>
          </p>
          {hero.cobertura.conOrden ? (
            <>
              <Carriles medios={hero.cobertura.medios} t0={hero.cobertura.t0} t1={hero.cobertura.t1} />
              <p class="nota">Orden entre las fuentes que Cotejo lee; otro medio pudo publicar antes.</p>
            </>
          ) : (
            <p class="nota">Medios: {hero.cobertura.medios.map((m) => m.nombre).join(', ')}.</p>
          )}
        </section>
      )}

      {secciones.map((s) => (
        <section id={s.clave} class="seccion-bloque">
          <h2 class="seccion">{s.nombre} <span>{s.eventos.length}</span></h2>
          <ul class="lista card">
            {s.eventos.map((e) => (
              <li class="fila">
                <div class="cuerpo">
                  <h3><a href={`${base}/evento/${e.id}/`}>{e.title}</a></h3>
                  <p class="meta">
                    <time datetime={iso(e.fecha)} data-rel>{fmt(e.fecha)}</time>{' '}
                    · {quienes(e)} · {e.notas.length} {e.notas.length === 1 ? 'nota' : 'notas'}
                  </p>
                  {e.cobertura.conOrden && <Carriles compacto medios={e.cobertura.medios} t0={e.cobertura.t0} t1={e.cobertura.t1} />}
                  {e.clasificado && (
                    <p class="registro" aria-label="Cobertura por tipo de medio">
                      {tiposActivos.map((t) => (
                        <span class={e.cubiertos.includes(t) ? 'cub' : 'ciego'}>
                          {e.cubiertos.includes(t) ? '■' : '□'} {TIPOS[t]}{e.cubiertos.includes(t) ? '' : ' (no lo cubrió)'}
                        </span>
                      ))}
                    </p>
                  )}
                </div>
                <div class="stat">
                  <b>{e.medios}</b>
                  <span>{e.medios === 1 ? 'medio' : 'medios'}</span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}

      {portada.length === 0 && <p>Todavía no hay hechos recientes con cobertura de varios medios.</p>}
      {!hayClasif && (
        <p class="nota">Cotejo todavía no muestra qué tipo de medio cubrió o no cada hecho: la clasificación de medios está en revisión.</p>
      )}
    </div>

    {comunicados.length > 0 && (
      <aside id="bva" class="bva card" aria-labelledby="bva-t">
        <h2 id="bva-t" class="seccion">Comunicados de la BVA <span>{comunicados.length}</span></h2>
        <p class="nota">Fuente primaria: la Bolsa de Valores de Asunción. Son avisos oficiales, no hechos cubiertos por la prensa.</p>
        <ul class="com">
          {recientes.map((e) => {
            const [tipo, nombre] = partir(e.title);
            return (
              <li>
                <time datetime={iso(e.fecha)} data-rel>{fmtCorto(e.fecha)}</time>
                <span class="tipo">{tipo}</span>
                <a href={e.notas[0].url} rel="noopener noreferrer">{nombre}</a>
              </li>
            );
          })}
        </ul>
        {anteriores.length > 0 && (
          <details>
            <summary>Ver {anteriores.length} anteriores</summary>
            <ul class="com">
              {anteriores.map((e) => {
                const [tipo, nombre] = partir(e.title);
                return (
                  <li>
                    <time datetime={iso(e.fecha)} data-rel>{fmtCorto(e.fecha)}</time>
                    <span class="tipo">{tipo}</span>
                    <a href={e.notas[0].url} rel="noopener noreferrer">{nombre}</a>
                  </li>
                );
              })}
            </ul>
          </details>
        )}
      </aside>
    )}
  </div>
</Base>
<style>
  [id] { scroll-margin-top: 4.5rem; }
  .intro { padding: 2rem 0 1.4rem; }
  .kicker { margin: 0 0 .5rem; font: 600 .75rem var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--accent); }
  .intro h1 { margin: 0; max-width: 18ch; font: 700 clamp(2rem, 5.4vw, 3.4rem)/1.05 var(--serif); letter-spacing: -.025em; text-wrap: balance; }
  .lede { margin: .9rem 0 0; max-width: 40rem; color: var(--muted); font-size: 1.02rem; }
  .upd { display: inline-block; margin-left: .35rem; font: .78rem var(--mono); white-space: nowrap; }

  .pagina { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; align-items: start; }
  @media (min-width: 64rem) {
    .pagina { grid-template-columns: minmax(0, 1fr) 20rem; gap: 2.5rem; }
    .bva { position: sticky; top: 4.5rem; max-height: calc(100vh - 6rem); overflow: auto; }
  }

  .hero { padding: 1.3rem 1.3rem 1.1rem; margin-bottom: 2rem; border-top: 3px solid var(--accent); }
  .hero-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; margin: 0 0 .8rem; }
  .como { font: .72rem var(--mono); color: var(--muted); cursor: help; }
  .hero h2 { margin: 0 0 .5rem; font: 700 clamp(1.6rem, 3.8vw, 2.4rem)/1.1 var(--serif); letter-spacing: -.02em; text-wrap: balance; }
  .hero h2 a { text-decoration: none; }
  .hero h2 a:hover { text-decoration: underline; text-decoration-color: var(--accent); }

  .seccion { margin: 0 0 .7rem; display: flex; align-items: baseline; gap: .5rem; font: 700 .8rem var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ink); }
  .seccion span { color: var(--accent); }
  .seccion-bloque { margin-bottom: 2rem; }
  .lista { list-style: none; margin: 0; padding: 0; overflow: hidden; }
  .fila { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; padding: 1rem 1.1rem; border-bottom: 1px solid var(--line); }
  .fila:last-child { border-bottom: 0; }
  .fila:hover { background: var(--accent-soft); }
  .fila:focus-within { outline: 3px solid var(--accent); outline-offset: -3px; }
  h3 { margin: 0 0 .3rem; font: 700 1.2rem/1.22 var(--serif); letter-spacing: -.01em; }
  h3 a { text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  h3 a:focus-visible { outline: none; }
  .stat { display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 3.6rem; padding-left: 1rem; border-left: 1px solid var(--line); }
  .stat b { font: 700 1.6rem/1 var(--serif); }
  .stat span { font: .66rem var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .registro { margin: .55rem 0 0; display: flex; flex-wrap: wrap; gap: .15rem .9rem; font: .75rem var(--mono); }
  .cub { color: var(--ink); }
  .ciego { color: var(--neg); font-weight: 700; }

  .bva { min-width: 0; padding: 1.1rem 1.1rem 1rem; }
  .com { list-style: none; margin: .5rem 0 0; padding: 0; font-size: .9rem; }
  .com li { padding: .5rem 0; border-top: 1px solid var(--line); display: grid; grid-template-columns: 4.2rem 1fr; gap: 0 .5rem; line-height: 1.3; }
  .com time { grid-row: span 2; font: .72rem var(--mono); color: var(--muted); padding-top: .15rem; }
  .com .tipo { font: .66rem var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .com a { overflow-wrap: anywhere; }
  summary { cursor: pointer; margin: .8rem 0 .2rem; padding: .5rem 0; min-height: 44px; font: 600 .8rem var(--mono); color: var(--accent); }
</style>
