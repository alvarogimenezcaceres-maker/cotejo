---
import Base from '../../layouts/Base.astro';
import Carriles from '../../components/Carriles.astro';
import { cargarEventos, fmt, TIPOS } from '../../lib/db.js';
export async function getStaticPaths() {
  const { eventos, comunicados, tiposActivos } = await cargarEventos();
  return [...eventos, ...comunicados].map((e) => ({ params: { id: String(e.id) }, props: { e, tiposActivos } }));
}
const { e, tiposActivos } = Astro.props;
const porMedio = new Map();
for (const n of e.notas) (porMedio.get(n.slug) ?? porMedio.set(n.slug, []).get(n.slug)).push(n);
const reportUrl = import.meta.env.PUBLIC_REPORT_URL;
const base = import.meta.env.BASE_URL;
const primero = e.cobertura.conOrden ? e.cobertura.medios[0].nombre : null;
const descripcion = `${e.medios} ${e.medios === 1 ? 'medio' : 'medios'} y ${e.notas.length} notas sobre este hecho. Cómo lo cubrió cada uno.`;
---
<Base title={`${e.title} · Cotejo`} description={descripcion}>
  <p class="volver"><a href={`${base}/`}>← Todos los hechos</a></p>
  <header class="cab">
    <h1>{e.title}</h1>
    <p class="meta">
      {e.medios} {e.medios === 1 ? 'medio' : 'medios'} · {e.notas.length} notas · Agrupado automáticamente
    </p>
  </header>

  {e.cobertura.conOrden && (
    <section class="radar card" aria-label="Cobertura en el tiempo">
      <h2 class="etq">Cobertura en el tiempo</h2>
      <Carriles medios={e.cobertura.medios} t0={e.cobertura.t0} t1={e.cobertura.t1} />
      <p class="nota">Orden entre las fuentes que Cotejo lee; otro medio pudo publicar antes. Diferencias menores a 10 minutos se muestran como "a la par".</p>
    </section>
  )}

  {e.clasificado ? (
    <table class="registro">
      <caption class="etq">Cobertura por tipo de medio</caption>
      <tbody>
        {tiposActivos.map((t) => (
          <tr class={e.cubiertos.includes(t) ? 'cub' : 'ciego'}>
            <th scope="row">{TIPOS[t]}</th>
            <td>{e.cubiertos.includes(t) ? '■ Lo cubrió' : '□ No lo cubrió'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : null}

  <p class="aviso">
    Sin resumen: solo titulares y enlaces. Cada nota pertenece a su medio.
    {!e.clasificado && ' La clasificación de medios está en revisión, por eso no se muestra el punto ciego de este hecho.'}
  </p>

  {[...porMedio.values()].map((notas) => (
    <section class:list={['medio card', { primero: notas[0].medio === primero }]}>
      <h2 class="etq">
        {notas[0].medio}{e.clasificado ? ` · ${TIPOS[notas[0].tipo]}` : ''}
        {notas[0].medio === primero && <span class="chip">publicó primero</span>}
      </h2>
      {notas.map((n) => (
        <article>
          <h3><a href={n.url} rel="noopener noreferrer">{n.nota}</a></h3>
          {n.snippet && <p class="frag">{n.snippet}</p>}
          {n.published_at && <p class="meta"><time datetime={new Date(n.published_at).toISOString()}>{fmt(n.published_at)}</time></p>}
        </article>
      ))}
    </section>
  ))}

  <section class="reporte card">
    <h2 class="etq">¿Hay un error en este hecho?</h2>
    {reportUrl ? (
      <form method="post" action={reportUrl}>
        <input type="hidden" name="event_id" value={e.id} />
        <label for="msg">Cuéntanos qué está mal (notas mal agrupadas, dato incorrecto)</label>
        <textarea id="msg" name="message" rows="4" required maxlength="1000"></textarea>
        <button type="submit">Enviar reporte</button>
      </form>
    ) : (
      <p>El formulario de reportes aún no está habilitado.</p>
    )}
  </section>
</Base>
<style>
  .volver { margin: 1.4rem 0 .4rem; font: .8rem var(--mono); }
  .volver a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; color: var(--muted); }
  .volver a:hover { color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent); }
  .cab h1 { margin: 0 0 .6rem; max-width: 26ch; font: 700 clamp(1.8rem, 4.6vw, 3rem)/1.08 var(--serif); letter-spacing: -.025em; text-wrap: balance; }
  .radar { padding: 1.1rem 1.2rem 1rem; margin: 1.4rem 0; border-top: 3px solid var(--accent); }
  .radar h2 { margin: 0; }
  .medio { padding: 1rem 1.2rem .4rem; margin-top: 1rem; }
  .medio.primero { border-left: 3px solid var(--accent); }
  .medio h2 { margin: 0 0 .7rem; display: flex; align-items: center; gap: .7rem; flex-wrap: wrap; color: var(--ink); }
  article { padding: .6rem 0 .8rem; border-top: 1px solid var(--line); }
  article:first-of-type { border-top: 0; }
  h3 { margin: 0 0 .25rem; font: 700 1.15rem/1.3 var(--serif); }
  .frag { margin: 0 0 .3rem; font-size: .95rem; color: var(--muted); }
  .registro { border-collapse: collapse; margin: 1rem 0; font: .85rem var(--mono); }
  .registro caption { text-align: left; padding-bottom: .4rem; }
  .registro th, .registro td { text-align: left; font-weight: 400; padding: .3rem 1.5rem .3rem 0; border-top: 1px solid var(--line); }
  .ciego td { color: var(--neg); font-weight: 700; }
  .reporte { padding: 1rem 1.2rem 1.2rem; margin-top: 2rem; }
  .reporte h2 { margin: 0 0 .6rem; }
  label { display: block; margin-bottom: .3rem; font-size: .95rem; }
  textarea { width: 100%; background: var(--bg); color: inherit; border: 1px solid var(--line); border-radius: 6px; font: inherit; padding: .6rem; }
  button { margin-top: .6rem; min-height: 44px; background: var(--accent); color: var(--bg); border: 0; border-radius: 6px; padding: .6rem 1.2rem; font: 700 .8rem var(--mono); text-transform: uppercase; letter-spacing: .06em; cursor: pointer; }
</style>
