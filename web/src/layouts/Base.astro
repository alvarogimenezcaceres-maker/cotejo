---
const {
  title = 'Cotejo',
  description = 'Cómo cubrió cada medio de Paraguay un mismo hecho de economía y mercado de valores, y quién no lo cubrió.',
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="Cotejo" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PY" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23b2331d'/%3E%3Ctext x='16' y='23' font-size='22' text-anchor='middle' fill='%23f3efe4' font-family='Georgia,serif' font-weight='700'%3EC%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <header class="mast">
      <a href={`${import.meta.env.BASE_URL}/`} class="logo">Cotejo</a>
      <p class="lema">Un mismo hecho, contado por cada medio.</p>
    </header>
    <main><slot /></main>
    <footer class="pie">
      <p>Cotejo guarda solo titular, un fragmento breve, enlace y fecha. El texto completo está en cada medio.
      La agrupación por hecho es automática y puede equivocarse. Código abierto (AGPL-3.0).</p>
    </footer>
    <script is:inline>
      // Fechas relativas ("hace 3 h"). Sin JavaScript se queda la fecha completa.
      document.querySelectorAll('time[data-rel]').forEach(function (t) {
        var ms = Date.now() - new Date(t.getAttribute('datetime')).getTime();
        var s;
        if (ms < 0) return;
        if (ms < 6e4) s = 'justo ahora';
        else if (ms < 36e5) s = 'hace ' + Math.round(ms / 6e4) + ' min';
        else if (ms < 864e5) s = 'hace ' + Math.round(ms / 36e5) + ' h';
        else if (ms < 6048e5) s = 'hace ' + Math.round(ms / 864e5) + ' d';
        else return;
        t.textContent = s;
      });
    </script>
  </body>
</html>
<style is:global>
  :root {
    --papel: #f3efe4; --tinta: #1b1a17; --gris: #5c584d; --regla: #cfc8b4; --acento: #b2331d;
    --serif: "Iowan Old Style", "Palatino Linotype", Charter, Georgia, serif;
    --mono: ui-monospace, "Cascadia Mono", Consolas, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root { --papel: #17161a; --tinta: #ece7da; --gris: #a39e90; --regla: #3a3730; --acento: #ee7a62; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--papel); color: var(--tinta); font: 18px/1.55 var(--serif); }
  main, .mast, .pie { max-width: 62rem; margin: 0 auto; padding: 0 1rem; }
  a { color: inherit; text-decoration-color: var(--regla); text-underline-offset: .2em; }
  a:hover { text-decoration-color: var(--acento); }
  a:focus-visible, button:focus-visible, textarea:focus-visible { outline: 3px solid var(--acento); outline-offset: 2px; }
  .mast { padding-top: 1.5rem; padding-bottom: .75rem; border-bottom: 3px double var(--tinta); display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem 1.5rem; }
  .logo { font-size: 2.6rem; font-weight: 700; letter-spacing: -.03em; text-decoration: none; line-height: 1; }
  .lema { margin: 0; color: var(--gris); font-style: italic; }
  .pie { margin-top: 4rem; padding-top: 1rem; padding-bottom: 3rem; border-top: 1px solid var(--regla); color: var(--gris); font-size: .85rem; }
  .etq { font: .72rem/1.2 var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--gris); }
  .aviso { border-left: 3px solid var(--acento); padding: .25rem 0 .25rem .75rem; color: var(--gris); font-size: .9rem; margin: 1.25rem 0; }
</style>
