---
import MercadoBarra from '../components/MercadoBarra.astro';
const {
  title = 'Cotejo',
  description = 'Cómo cubrió cada medio de Paraguay un mismo hecho de economía y mercado de valores, y quién no lo cubrió.',
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/alvarogimenezcaceres-maker/cotejo';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="Cotejo" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PY" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231d4ed8'/%3E%3Ctext x='16' y='23' font-size='22' text-anchor='middle' fill='%23ffffff' font-family='Georgia,serif' font-weight='700'%3EC%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <a class="salto" href="#contenido">Ir al contenido</a>
    <header class="mast">
      <div class="mast-in">
        <a href={`${base}/`} class="marca" aria-label="Cotejo, inicio">
          <span class="sello" aria-hidden="true">C</span>
          <span class="nombre">Cotejo</span>
        </a>
        <nav class="nav" aria-label="Secciones">
          <a href={`${base}/`}>Hoy</a>
          <a href={`${base}/#bolsa`}>Mercado de valores</a>
          <a href={`${base}/#economia`}>Economía</a>
          <a href={`${base}/#bva`}>Comunicados BVA</a>
          <a href={`${repo}/blob/main/docs/metodologia.md`} rel="noopener noreferrer">Metodología</a>
        </nav>
      </div>
    </header>
    <MercadoBarra />
    <main id="contenido"><slot /></main>
    <footer class="pie">
      <div class="pie-in">
        <p class="pie-lema">Un mismo hecho, contado por cada medio.</p>
        <p>Cotejo guarda solo el titular, un fragmento breve, el enlace y la fecha. El texto completo está en cada medio.
        La agrupación por hecho es automática y puede equivocarse. Nada de lo que se muestra es asesoramiento financiero.</p>
        <p>
          <a href={`${repo}/blob/main/docs/metodologia.md`} rel="noopener noreferrer">Metodología</a> ·
          <a href={repo} rel="noopener noreferrer">Código abierto (AGPL-3.0)</a>
        </p>
      </div>
    </footer>
    <script is:inline>
      // Fechas relativas ("hace 3 h"). Sin JavaScript se queda la fecha completa.
      document.querySelectorAll('time[data-rel]').forEach(function (t) {
        var ms = Date.now() - new Date(t.getAttribute('datetime')).getTime();
        var s;
        if (ms < 0) return;
        if (ms < 6e4) s = 'justo ahora';
        else if (ms < 36e5) s = 'hace ' + Math.round(ms / 6e4) + ' min';
        else if (ms < 864e5) s = 'hace ' + Math.round(ms / 36e5) + ' h';
        else if (ms < 6048e5) s = 'hace ' + Math.round(ms / 864e5) + ' d';
        else return;
        t.textContent = s;
      });
    </script>
  </body>
</html>
<style is:global>
  :root {
    --bg: #f6f4ee; --surface: #ffffff; --ink: #0f1b2d; --muted: #4b5870; --line: #ddd8cb;
    --accent: #1d4ed8; --accent-soft: #e8eefc; --pos: #0b7a4b; --neg: #b42318;
    --serif: "Iowan Old Style", "Palatino Linotype", Charter, Georgia, serif;
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --mono: ui-monospace, "Cascadia Mono", "SF Mono", Consolas, monospace;
    --r: 8px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0a1020; --surface: #111a2e; --ink: #e8edf7; --muted: #9ba8c0; --line: #223049;
      --accent: #8fb2ff; --accent-soft: #15233f; --pos: #3dd68c; --neg: #ff8a7a;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.55 var(--sans); font-variant-numeric: tabular-nums; }
  main, .mast-in, .pie-in { max-width: 72rem; margin: 0 auto; padding-left: 1rem; padding-right: 1rem; }
  a { color: inherit; text-decoration-color: color-mix(in srgb, var(--ink) 30%, transparent); text-underline-offset: .2em; }
  a:hover { text-decoration-color: var(--accent); }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; border-radius: 3px; }
  .salto { position: absolute; left: -999px; top: 0; background: var(--accent); color: var(--surface); padding: .6rem 1rem; z-index: 10; }
  .salto:focus { left: .5rem; top: .5rem; }

  .mast { position: sticky; top: 0; z-index: 5; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .mast-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .1rem 1.5rem; min-height: 3.5rem; }
  .marca { display: inline-flex; align-items: center; gap: .6rem; text-decoration: none; min-height: 44px; }
  .sello { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 6px; background: var(--accent); color: var(--bg); font: 700 1.25rem/1 var(--serif); }
  .nombre { font: 700 1.55rem/1 var(--serif); letter-spacing: -.02em; }
  .nav { display: flex; flex-wrap: wrap; gap: 0 1.25rem; font-size: .88rem; }
  .nav a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; color: var(--muted); }
  .nav a:hover { color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent); }

  time { white-space: nowrap; }
  @media (max-width: 47.99rem) {
    .mast { position: static; }
    .mast-in { padding-top: .35rem; }
    .nav { width: 100%; flex-wrap: nowrap; overflow-x: auto; white-space: nowrap; gap: 0 1.1rem; scrollbar-width: none; }
    .nav::-webkit-scrollbar { display: none; }
  }
  .pie { margin-top: 4rem; border-top: 1px solid var(--line); background: var(--surface); color: var(--muted); font-size: .85rem; }
  .pie-in { padding-top: 1.5rem; padding-bottom: 2.5rem; max-width: 72rem; }
  .pie-lema { font: italic 1.15rem var(--serif); color: var(--ink); margin: 0 0 .6rem; }
  .pie p { max-width: 46rem; margin: .4rem 0; }

  .etq { font: 600 .72rem/1.2 var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
  .meta { margin: 0; font: .78rem/1.5 var(--mono); color: var(--muted); }
  .nota { margin: .5rem 0 0; font-size: .82rem; color: var(--muted); }
  .aviso { border-left: 3px solid var(--accent); padding: .3rem 0 .3rem .8rem; color: var(--muted); font-size: .9rem; margin: 1.1rem 0; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); }
  .chip { display: inline-block; font: 700 .68rem/1 var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--accent); background: var(--accent-soft); padding: .35rem .55rem; border-radius: 999px; }
  @media (prefers-reduced-motion: no-preference) { a, .fila { transition: background-color .15s ease, text-decoration-color .15s ease; } }
</style>
